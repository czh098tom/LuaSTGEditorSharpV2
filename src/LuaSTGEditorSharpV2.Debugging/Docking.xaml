<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com"
                    xmlns:lw="clr-namespace:LuaSTGEditorSharpV2.WPF;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:lwc="clr-namespace:LuaSTGEditorSharpV2.WPF.Converter;assembly=LuaSTGEditorSharpV2.WPF">
    <DataTemplate x:Key="DebugOutputPageViewModel">
        <Grid Background="{DynamicResource ResourceKey=inspector:background_brush}">
            <Grid.Resources>
                <lwc:BoolToVisibilityConverter PositiveVisibility="Visible" 
                                               NegativeVisibility="Collapsed" 
                                               x:Key="BoolToVisibilityConverter" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToolBarTray Grid.Row="0" IsLocked="True">
                <ToolBar>
                    <TextBlock Text="{lex:Loc LuaSTGEditorSharpV2.Debugging:Localized:panel_output_source_label}"
                               VerticalAlignment="Center"/>
                    <ComboBox Width="150" Margin="5,0,0,0"
                              SelectedIndex="{Binding SelectedOutputSourceIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding OutputSourceNames}"/>
                    <Separator />
                    <Button Content="{lex:Loc LuaSTGEditorSharpV2.Debugging:Localized:panel_output_clear}"
                            Command="{Binding ClearOutputCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </ToolBar>
            </ToolBarTray>
            <lw:LoggingTextBox Grid.Row="1" Visibility="{Binding BuildingTextIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                               LastAppendedText="{Binding LastBuildingAppendedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ClearStream="{Binding ClearStream}"/>
            <lw:LoggingTextBox Grid.Row="1" Visibility="{Binding DebugTextIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                               LastAppendedText="{Binding LastDebugAppendedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ClearStream="{Binding ClearStream}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>