{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "CreateSimpleBullet",
	"Captures": {
		"style": {"Key": "style"},
		"color": {"Key": "color"},
		"position": {"Key": "position"},
		"velocity": {"Key": "velocity"},
		"rotation": {"Key": "rotation"},
		"aim": {"Key": "aim"},
		"omega": {"Key": "omega"},
		"stay": {"Key": "stay"},
		"destroyable": {"Key": "destroyable"},
		"delay": {"Key": "delay"},
		"rebound": {"Key": "rebound"},
		"acceleration": {"Key": "acceleration"},
		"accel_angle": {"Key": "accel_angle"},
		"max_velocity": {"Key": "max_velocity"},
		"shuttle": {"Key": "shuttle"}
	},
	"ConditionTemplates": {
		"has_children": "{{logicalChildrenCount}} > 0"
	},
	"Head": [
		"last = New(_straight, ",
			"{{{self.style}}}, {{{self.color}}}, {{{self.position}}}, ",
			"{{{self.velocity}}}, {{{self.rotation}}}, {{{self.aim}}}, ",
			"{{{self.omega}}}, {{{self.stay}}}, {{{self.destroyable}}}, ",
			"{{{self.delay}}}, {{{self.rebound}}}, {{{self.acceleration}}}, ",
			"{{{self.accel_angle}}}, {{{self.max_velocity}}}, {{{self.shuttle}}})",
			"{{#condition.has_children}}\n",
		"do\n",
		"{{{indent}}}local self = last{{/condition.has_children}}"
	],
	"Tail": [
		"{{#condition.has_children}}end{{/condition.has_children}}"
	]
}
