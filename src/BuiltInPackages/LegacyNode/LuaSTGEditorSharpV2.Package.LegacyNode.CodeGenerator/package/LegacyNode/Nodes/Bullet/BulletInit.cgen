{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "BulletInit",
	"Captures": {
		"style": {
			"Key": "style"
		},
		"parameters": {
			"Key": "parameters",
			"DisableMacro": true
		},
		"color": {
			"Key": "color"
		},
		"stay": {
			"Key": "stay"
		},
		"destroyable": {
			"Key": "destroyable"
		}
	},
	"ContextCaptures": {
		"definition": {
			"TypeUID": "DefineBullet",
			"Property": {
				"identifier": {
					"Key": "identifier",
					"DisableMacro": true
				},
				"difficulty": {
					"Key": "difficulty",
					"DisableMacro": true
				}
			}
		}
	},
	"ConditionTemplates": {
		"difficulty_is_all": "'{{{context.definition.difficulty}}}' == '\"All\"'"
	},
	"Head": [
		"_editor_class[{{{context.definition.identifier}}}",
			"{{^condition.difficulty_is_all}} .. ':' .. {{{context.definition.difficulty}}}{{/condition.difficulty_is_all}}",
			"].init = function(self, _x, _y",
			"{{#self.parameters}}, {{{self.parameters}}}{{/self.parameters}})\n",
		"{{{indent}}}bullet.init(self,{{{self.style}}},{{{self.color}}},{{{self.stay}}},{{{self.destroyable}}})\n",
		"{{{indent}}}self.x, self.y = _x, _y"
	],
	"Tail": [
		"end"
	]
}