	"Tail": [
		{ "Text": "{0:IND}task.New(self, function()" },
		{ "Text": "{0:IND}{0:IND}while coroutine.status(self.task[1])~='dead' do task.Wait() end" },
		{ "Text": "{0:IND}{0:IND}stage.group.FinishReplay()" },
		{ "Text": "{0:IND}{0:IND}New(mask_fader, 'close')" },
