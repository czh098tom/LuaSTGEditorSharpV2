		{ "Text": "{0:IND}{0:IND}{0:IND}{0:IND}{0:IND}{0:IND}SetBGMVolume(v, 1 - i / 30)" },
		{ "Text": "{0:IND}{0:IND}{0:IND}{0:IND}{0:IND}end" },
		{ "Text": "{0:IND}{0:IND}{0:IND}{0:IND}end" },
