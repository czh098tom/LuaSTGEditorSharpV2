{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "DefineSpellCard",
	"Captures": {
		"spellcard_name": { "Key": "spellcard_name", "DisableMacro": true },
		"protect_time": { "Key": "protect_time" },
		"resist_time": { "Key": "resist_time" },
		"total_time": { "Key": "total_time" },
		"hp": { "Key": "hp" },
		"power_amount": { "Key": "power_amount" },
		"faith_amount": { "Key": "faith_amount" },
		"point_amount": { "Key": "point_amount" },
		"bomb_immunity": { "Key": "bomb_immunity" },
		"opening_performance": { "Key": "opening_performance" },
		"optional_id": { "Key": "optional_id" }
	},
	"ContextCaptures": {
		"defineboss": {
			"TypeUID": "DefineBoss",
			"Property": {
				"identifier": { "Key": "identifier", "DisableMacro": true },
				"difficulty": { "Key": "difficulty", "DisableMacro": true }
			}
		}
	},
	"ConditionTemplates": {
		"has_optional_id": "'{{{self.optional_id}}}' != '' and '{{{self.optional_id}}}' != '\"\"'",
		"spellcard_is_named": "'{{{self.spellcard_name}}}' != '' and '{{{self.spellcard_name}}}' != '\"\"'",
		"boss_difficulty_is_all": "'{{{context.defineboss.difficulty}}}' == '\"All\"'"
	},
	"Head": [
		"_tmp_sc = boss.card.New({{{self.spellcard_name}}}, {{{self.protect_time}}}, {{{self.resist_time}}}, {{{self.total_time}}}, ",
			"{{{self.hp}}}, { {{{self.power_amount}}}, {{{self.faith_amount}}}, {{{self.point_amount}}} }, {{{self.bomb_immunity}}})"
	],
	"Tail": [
		"_tmp_sc.perform = {{{self.opening_performance}}}{{#condition.has_optional_id}}\n",
		"_editor_cards.{{{self.optional_id}}} = _tmp_sc{{/condition.has_optional_id}}\n",
		"table.insert(_editor_class[{{{context.defineboss.identifier}}}",
			"{{^condition.boss_difficulty_is_all}} .. ':' .. {{{context.defineboss.difficulty}}}{{/condition.boss_difficulty_is_all}}",
			"].cards, _tmp_sc){{#condition.spellcard_is_named}}\n",
		"table.insert(_sc_table, { ",
			"{{{context.defineboss.identifier}}}",
			"{{^condition.boss_difficulty_is_all}} .. ':' .. {{{context.defineboss.difficulty}}}{{/condition.boss_difficulty_is_all}}",
			", {{{self.spellcard_name}}}, _tmp_sc, #_editor_class[{{{context.defineboss.identifier}}}",
			"{{^condition.boss_difficulty_is_all}} .. ':' .. {{{context.defineboss.difficulty}}}{{/condition.boss_difficulty_is_all}}",
			"].cards, {{{self.opening_performance}}}}){{/condition.spellcard_is_named}}"
	],
	"IndentionIncrement": 0
}