{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "DefineBoss",
	"Captures": {
		"identifier": { "Key": "identifier", "DisableMacro": true },
		"difficulty": { "Key": "difficulty", "DisableMacro": true },
		"name": { "Key": "name", "DisableMacro": true },
		"background": { "Key": "background" },
		"bgm": { "Key": "bgm" }
	},
	"ConditionTemplates": {
		"difficulty_is_all": "'{{{self.difficulty}}}' == '\"All\"'",
		"has_background": "'{{{self.background}}}' != ''"
	},
	"Head": [
		"_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}] = Class(boss)",
		"_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}].cards = {}",
		"_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}].name = {{{self.name}}}",
		"_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}].bgm = {{{self.bgm}}}",
		"{{#condition.has_background}}_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}]._bg = {{{self.background}}}{{/condition.has_background}}{{^condition.has_background}}_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}]._bg = nil{{/condition.has_background}}",
		"_editor_class[{{{self.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{self.difficulty}}}{{/condition.difficulty_is_all}}].difficulty = {{{self.difficulty}}}"
	],
	"IndentionIncrement": 0
}