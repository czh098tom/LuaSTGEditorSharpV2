{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "BossMoveTo",
	"Captures": {
		"position": {
			"Key": "position"
		},
		"time": {
			"Key": "time"
		},
		"mode": {
			"Key": "mode"
		}
	},
	"ContextCaptures": {
		"definition": {
			"TypeUID": "DefineBoss",
			"Property": {
				"identifier": {
					"Key": "identifier",
					"DisableMacro": true
				},
				"difficulty": {
					"Key": "difficulty",
					"DisableMacro": true
				}
			}
		}
	},
	"ConditionTemplates": {
		"difficulty_is_all": "'{{{context.definition.difficulty}}}' == '\"All\"'"
	},
	"Head": [
		"table.insert(_editor_class[{{{context.definition.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{context.definition.difficulty}}}{{/condition.difficulty_is_all}}].cards, boss.move.New({{{self.position}}}, {{{self.time}}}, {{{self.mode}}}))"
	]
}