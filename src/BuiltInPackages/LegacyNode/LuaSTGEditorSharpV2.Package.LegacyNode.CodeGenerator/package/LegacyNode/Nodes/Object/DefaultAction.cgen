{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "DefaultAction",
	"ContextCaptures": {
		"callback": {
			"TypeUID": "CallBack",
			"Property": {
				"type": { "Key": "type" }
			}
		}
	},
	"ConditionTemplates": {
		"is_colli": "'{{context.callback.type}}'=='colli'",
		"has_callback": "'{{context.callback.type}}'!=''"
	},
	"Head": ["{{#condition.has_callback}}self.class.base.{{context.callback.type}}(self{{#condition.is_colli}}, other{{/condition.is_colli}}){{/condition.has_callback}}{{^condition.has_callback}}self.class.base.render(self){{/condition.has_callback}}"]
}