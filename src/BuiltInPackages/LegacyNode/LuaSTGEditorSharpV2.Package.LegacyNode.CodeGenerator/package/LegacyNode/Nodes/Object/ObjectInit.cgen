		},
		"hp": {
			"Key": "hp"
		},
		"collision": {
			"Key": "collision"
		}
	},
	"ContextCaptures": {
		"definition": {
			"TypeUID": "DefineObject",
			"Property": {
				"identifier": {
					"Key": "identifier",
					"DisableMacro": true
				},
				"difficulty": {
					"Key": "difficulty",
					"DisableMacro": true
				}
			}
		}
	},
	"ConditionTemplates": {
		"difficulty_is_all": "'{{{context.definition.difficulty}}}' == '\"All\"'"
	},
	"Head": [
		"_editor_class[{{{context.definition.identifier}}}{{^condition.difficulty_is_all}} .. ':' .. {{{context.definition.difficulty}}}{{/condition.difficulty_is_all}}].init = function(self, _x, _y{{#self.parameters}}, {{{self.parameters}}}{{/self.parameters}})",
		"{0:IND}self.x, self.y = _x, _y",
		"{0:IND}self.img = {{{self.image}}}",
		"{0:IND}self.layer = {{{self.layer}}}",
		"{0:IND}self.group = {{{self.group}}}",
		"{0:IND}self.hide = {{{self.hide}}}",
		"{0:IND}self.bound = {{{self.bound}}}",
		"{0:IND}self.navi = {{{self.navigate}}}",
		"{0:IND}self.hp = {{{self.hp}}}",
		"{0:IND}self.maxhp = {{{self.hp}}}",
		"{0:IND}self.colli = {{{self.collision}}}",
		"{0:IND}self._servants = {}",
		"{0:IND}self._blend, self._a, self._r, self._g, self._b = '', 255, 255, 255, 255"
	],
	"Tail": [
		"end"
	]
}