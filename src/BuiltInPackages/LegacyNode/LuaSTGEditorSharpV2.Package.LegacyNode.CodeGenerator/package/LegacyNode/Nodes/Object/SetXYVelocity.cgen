{
  "$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator",
  "TypeUID": "SetXYVelocity",
  "Captures": {
    "target": { "Key": "target" },
    "velocity": { "Key": "velocity" },
    "set_rotation": { "Key": "set_rotation", "DisableMacro": true }
  },
  "ConditionTemplates": {
    "set_rotation": "'{{self.set_rotation}}' == 'true'"
  },
  "Head": [
    "{{{self.target}}}.vx, {{{self.target}}}.vy = {{{self.velocity}}}",
      "{{#condition.set_rotation}}\n",
    "{{{self.target}}}.rot = atan2({{{self.target}}}.vy, {{{self.target}}}.vx){{/condition.set_rotation}}"
  ]
}
