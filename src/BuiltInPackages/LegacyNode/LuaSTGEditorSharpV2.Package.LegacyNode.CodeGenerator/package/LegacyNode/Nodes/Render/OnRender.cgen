{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "OnRender",
	"ContextCaptures": {
		"definition": {
			"AnyOfTypeUIDs": [ "DefineObject", "DefineBullet", "DefineLaser", "DefineBentLaser", "DefineEnemy" ],
			"Property": {
				"identifier": { "Key": "identifier", "DisableMacro": true },
				"difficulty": { "Key": "difficulty", "DisableMacro": true }
			}
		}
	},
	"ConditionTemplates": {
		"difficulty_is_all": "'{{{context.definition.difficulty}}}' == '\"All\"'"
	},
	"Head": [
		"_editor_class[{{{context.definition.identifier}}}",
			"{{^condition.difficulty_is_all}} .. ':' .. {{{context.definition.difficulty}}}{{/condition.difficulty_is_all}}",
			"].render = function(self)"
	],
	"Tail": [
		"end"
	]
}
