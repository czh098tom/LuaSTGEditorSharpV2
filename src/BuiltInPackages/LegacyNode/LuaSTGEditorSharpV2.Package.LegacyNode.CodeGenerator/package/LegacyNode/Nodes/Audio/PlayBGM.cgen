{
	"$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.MustacheCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
	"TypeUID": "PlayBGM",
	"Captures": {
		"name": { "Key": "name" },
		"time": { "Key": "time" },
		"set_stage_time": { "Key": "set_stage_time" }
	},
	"ConditionTemplates": {
		"time_set": "'{{{self.time}}}' != ''",
		"stage_frame_set": "'{{{self.time}}}' != '' && '{{{self.set_stage_time}}}' != ''"
	},
	"Head": [
		"{{^condition.time_set}}",
		"LoadMusicRecord({{{self.name}}})\n",
		"_play_music({{{self.name}}})",
		"{{/condition.time_set}}{{#condition.time_set}}",
		"LoadMusicRecord({{{self.name}}})\n",
		"_play_music({{{self.name}}},{{{self.time}}})",
		"{{#condition.stage_frame_set}}\n",
		"{0:IND}if {{{self.set_stage_time}}} then ex.stageframe=int({{{self.time}}}*60) end",
		"{{/condition.stage_frame_set}}{{/condition.time_set}}"
	]
}