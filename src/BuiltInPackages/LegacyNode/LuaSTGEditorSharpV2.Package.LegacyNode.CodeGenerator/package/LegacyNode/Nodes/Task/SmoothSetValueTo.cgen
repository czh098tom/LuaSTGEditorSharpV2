{
  "$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.JoinedListCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator",
  "TypeUID": "SmoothSetValueTo",
  "Language": "Lua",
  "CountCapture": { "Key": "count" },
  "MaximumCount": 100,
  "Captures": {
    "target": { "Key": "target" },
    "delay": { "Key": "delay" },
    "duration": { "Key": "duration" }
  },
  "RequiredCaptureName": "value",
  "ItemCaptures": {
    "name": { "Key": "variable_name{0}", "DisableMacro": true },
    "value": { "Key": "target_value{0}" },
    "interpolation": { "Key": "interpolation_mode{0}" },
    "modification": { "Key": "modification_mode{0}" }
  },
  "Columns": {
    "tasks": {
      "Separator": "",
      "Template": [
        "{{#args.item.value.Length}}",
        "lasttask = task.New({{{self.target}}},function()ex.SmoothSetValueTo(",
        "{{{args.item.name}}},{{{args.item.value}}},",
        "{{#self.duration.Length}}{{{self.duration}}}{{/self.duration.Length}}{{^self.duration.Length}}1{{/self.duration.Length}},",
        "{{{args.item.interpolation}}},nil,",
        "{{#self.delay.Length}}{{{self.delay}}}{{/self.delay.Length}}{{^self.delay.Length}}0{{/self.delay.Length}},",
        "{{{args.item.modification}}})end)\n",
        "{{/args.item.value.Length}}"
      ]
    }
  },
  "Head": [ "{{{args.columns.tasks}}}" ]
}
