  "BodyHead": [ "local curr, ibeg, ky, kx\nlocal prev = {{{args.previousValue}}}\nlocal target = offset" ],
  "BodyTail": [ "offset = target" ],
  "TaskTail": [ "{{#condition.roundRobin}}{0:IND}end\n{{/condition.roundRobin}}{0:IND}__terminateCount = __terminateCount + 1\nend)" ],
