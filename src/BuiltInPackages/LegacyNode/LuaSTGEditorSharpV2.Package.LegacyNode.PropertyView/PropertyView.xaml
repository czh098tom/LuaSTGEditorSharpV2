<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lwctrl="clr-namespace:LuaSTGEditorSharpV2.WPF.Controls;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:lsv="clr-namespace:LuaSTGEditorSharpV2.View;assembly=LuaSTGEditorSharpV2.View">
    <DataTemplate x:Key="property:nativePropertyTween">
        <lsv:PropertyItemGrid>
            <Grid Grid.Column="0" Margin="5,0,5,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Text="{Binding VariableName, Mode=TwoWay}" IsEditable="True"
                          Padding="0" MaxWidth="80"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          ItemsSource="{Binding Type.Parameters[VariableNamePresets], Mode=OneWay, Converter={StaticResource comboBoxConverter}}"/>
				<TextBlock Grid.Column="1" Text=" ▶" HorizontalAlignment="Right"/>
			</Grid>
			<Grid Grid.Column="1" Grid.ColumnSpan="2">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<lwctrl:ExpressionSpinner Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
				                          Step="{Binding Type.Parameters[Step]}"
				                          MinWidth="150"
				                          Padding="-1"
				                          Grid.ColumnSpan="2"
				                          HorizontalAlignment="Stretch"
				                          VerticalAlignment="Stretch"/>
				<ComboBox Text="{Binding InterpolationMode, Mode=TwoWay}" IsEditable="True"
                          Padding="0"
                          VerticalAlignment="Top"
                          Grid.Column="0" Grid.Row="1"
                          ItemsSource="{Binding Type.Parameters[InterpolationModePresets], Mode=OneWay, Converter={StaticResource comboBoxConverter}}"/>
				<ComboBox Text="{Binding ModificationMode, Mode=TwoWay}" IsEditable="True"
                          Padding="0"
                          VerticalAlignment="Top"
                          Grid.Column="1" Grid.Row="1"
                          ItemsSource="{Binding Type.Parameters[ModificationModePresets], Mode=OneWay, Converter={StaticResource comboBoxConverter}}"/>
			</Grid>
		</lsv:PropertyItemGrid>
    </DataTemplate>
</ResourceDictionary>
