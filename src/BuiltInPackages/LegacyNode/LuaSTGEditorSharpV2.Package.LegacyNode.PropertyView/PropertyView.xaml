<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lsv="clr-namespace:LuaSTGEditorSharpV2.View;assembly=LuaSTGEditorSharpV2.View">
	<DataTemplate x:Key="property:smoothsetvalue">
		<lsv:PropertyItemGrid>
			<Grid Grid.Column="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
				</Grid.ColumnDefinitions>
				<TextBox Grid.Column="0" Text="{Binding VariableName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
				<TextBlock Grid.Column="1" Text=" ▶ " />
			</Grid>
			<Grid Grid.Column="1" Grid.ColumnSpan="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="8"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="8"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<TextBox Grid.Column="0" Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
				<RibbonSeparator Grid.Column="1"/>
				<TextBox Grid.Column="2" Text="{Binding InterpolationMode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
				<RibbonSeparator Grid.Column="3"/>
				<TextBox Grid.Column="4" Text="{Binding ModificationMode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
			</Grid>
		</lsv:PropertyItemGrid>
	</DataTemplate>
</ResourceDictionary>
