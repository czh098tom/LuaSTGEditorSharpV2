{
  "$type": "LuaSTGEditorSharpV2.Core.CodeGenerator.Configurable.Mustache.JoinedListCodeGeneration, LuaSTGEditorSharpV2.Core.CodeGenerator",
  "TypeUID": "LocalVariable",
  "Language": "Lua",
  "IgnoreChildren": true,
  "CountCapture": {
    "DefaultValue": "0",
    "Key": "count"
  },
  "MaximumCount": 100,
  "RequiredCaptureName": "name",
  "ItemCaptures": {
    "name": {
      "Key": "name_{0}",
      "DisableMacro": true
    },
    "value": {
      "Key": "value_{0}",
      "DisableMacro": false
    }
  },
  "Columns": {
    "declarations": {
      "Separator": "\n",
      "Template": [
        "local {{{args.item.name}}}{{#args.rawItem.value.Length}}=({{{args.item.value}}}){{/args.rawItem.value.Length}}"
      ]
    }
  },
  "Head": [
    "{{#args.hasItems}}{{{args.columns.declarations}}}{{/args.hasItems}}"
  ]
}
