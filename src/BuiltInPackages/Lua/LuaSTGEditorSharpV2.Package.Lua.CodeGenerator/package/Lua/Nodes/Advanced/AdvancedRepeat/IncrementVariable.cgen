{
    "$type": "LuaSTGEditorSharpV2.Package.Lua.CodeGenerator.Specialized.AdvancedRepeat.TemplateVariableTransformationCodeGeneration, LuaSTGEditorSharpV2.Package.Lua.CodeGenerator",
    "TypeUID": "IncrementVariable",
    "Language": "Lua",
    "Captures": {
        "name": {
            "Key": "name",
            "DisableMacro": true
        },
        "init": {
            "Key": "init"
        },
        "increment": {
            "Key": "increment"
        }
    },
    "Initialization": [
        "local {{self.name}}={{{self.init}}}",
            " local _d_{{self.name}}=({{{self.increment}}})"
    ],
    "Update": [
        "{{{indent}}}{{self.name}}={{self.name}}+_d_{{self.name}}"
    ]
}
