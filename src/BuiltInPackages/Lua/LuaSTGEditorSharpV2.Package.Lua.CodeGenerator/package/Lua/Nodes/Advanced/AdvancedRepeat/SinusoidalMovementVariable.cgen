{
    "$type": "LuaSTGEditorSharpV2.Package.Lua.CodeGenerator.Specialized.AdvancedRepeat.TemplateVariableTransformationCodeGeneration, LuaSTGEditorSharpV2.Package.Lua.CodeGenerator",
    "TypeUID": "SinusoidalMovementVariable",
    "Language": "Lua",
    "Captures": {
        "name": {
            "Key": "name",
            "DisableMacro": true
        },
        "initial_phase": {
            "Key": "initial_phase"
        },
        "min": {
            "Key": "min"
        },
        "max": {
            "Key": "max"
        },
        "num_of_period": {
            "Key": "num_of_period"
        },
        "precisely": {
            "Key": "precisely",
            "DisableMacro": true
        }
    },
    "ContextCaptures": {
        "repeat": {
            "TypeUID": "AdvancedRepeat",
            "Property": {
                "times": {
                    "Key": "times"
                }
            }
        }
    },
    "ConditionTemplates": {
        "precise": "'{{self.precisely}}' == 'true'"
    },
    "Initialization": [
        "local _h_{{self.name}}=({{{self.max}}}-({{{self.min}}}))/2",
            " local _t_{{self.name}}=({{{self.max}}}+({{{self.min}}}))/2",
            " local {{self.name}}=_h_{{self.name}}*sin({{{self.initial_phase}}})+_t_{{self.name}}",
            " local _w_{{self.name}}={{{self.initial_phase}}}",
            " local _d_w_{{self.name}}={{{self.num_of_period}}}*360/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})"
    ],
    "Update": [
        "{0:IND}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " {{self.name}}=_h_{{self.name}}*sin(_w_{{self.name}})+_t_{{self.name}}"
    ]
}