{
    "$type": "LuaSTGEditorSharpV2.Package.Lua.CodeGenerator.Specialized.AdvancedRepeat.TemplateVariableTransformationCodeGeneration, LuaSTGEditorSharpV2.Package.Lua.CodeGenerator",
    "TypeUID": "SinusoidalInterpolationVariable",
    "Language": "Lua",
    "Captures": {
        "name": {
            "Key": "name",
            "DisableMacro": true
        },
        "from": {
            "Key": "from"
        },
        "to": {
            "Key": "to"
        },
        "precisely": {
            "Key": "precisely",
            "DisableMacro": true
        },
        "interpolation": {
            "Key": "interpolation",
            "DisableMacro": true
        }
    },
    "ContextCaptures": {
        "repeat": {
            "TypeUID": "AdvancedRepeat",
            "Property": {
                "times": {
                    "Key": "times"
                }
            }
        }
    },
    "ConditionTemplates": {
        "accel": "'{{self.interpolation}}' == 'SINE_ACCEL'",
        "decel": "'{{self.interpolation}}' == 'SINE_DECEL'",
        "halfPeriod": "'{{self.interpolation}}' != 'SINE_ACCEL' && '{{self.interpolation}}' != 'SINE_DECEL'",
        "precise": "'{{self.precisely}}' == 'true'"
    },
    "Initialization": [
        "{{#condition.accel}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _w_{{self.name}}=-90",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _d_w_{{self.name}}=90/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.accel}}",
            "{{#condition.decel}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _w_{{self.name}}=0",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _d_w_{{self.name}}=90/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.decel}}",
            "{{#condition.halfPeriod}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _w_{{self.name}}=-90",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _d_w_{{self.name}}=180/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.halfPeriod}}"
    ],
    "Update": [
        "{{{indent}}}",
            "{{#condition.accel}}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " {{self.name}}=(_end_{{self.name}}-_beg_{{self.name}})*sin(_w_{{self.name}})+(_end_{{self.name}})",
            "{{/condition.accel}}",
            "{{#condition.decel}}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " {{self.name}}=(_end_{{self.name}}-_beg_{{self.name}})*sin(_w_{{self.name}})+(_beg_{{self.name}})",
            "{{/condition.decel}}",
            "{{#condition.halfPeriod}}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " {{self.name}}=(_end_{{self.name}}-_beg_{{self.name}})/2*sin(_w_{{self.name}})+((_end_{{self.name}}+_beg_{{self.name}})/2)",
            "{{/condition.halfPeriod}}"
    ]
}