{
    "$type": "LuaSTGEditorSharpV2.Package.Lua.CodeGenerator.Specialized.AdvancedRepeat.TemplateVariableTransformationCodeGeneration, LuaSTGEditorSharpV2.Package.Lua.CodeGenerator",
    "TypeUID": "LinearVariable",
    "Language": "Lua",
    "Captures": {
        "name": {
            "Key": "name",
            "DisableMacro": true
        },
        "from": {
            "Key": "from"
        },
        "to": {
            "Key": "to"
        },
        "precisely": {
            "Key": "precisely",
            "DisableMacro": true
        },
        "mode": {
            "Key": "mode",
            "DisableMacro": true
        }
    },
    "ContextCaptures": {
            "repeat": {
                "TypeUID": "AdvancedRepeat",
                "Property": {
                    "times": {
                        "Key": "times"
                    }
                }
            }
    },
    "ConditionTemplates": {
            "accel": "'{{self.mode}}' == 'MOVE_ACCEL'",
            "decel": "'{{self.mode}}' == 'MOVE_DECEL'",
            "accDec": "'{{self.mode}}' == 'MOVE_ACC_DEC'",
            "normal": "'{{self.mode}}' != 'MOVE_ACCEL' && '{{self.mode}}' != 'MOVE_DECEL' && '{{self.mode}}' != 'MOVE_ACC_DEC'",
            "precise": "'{{self.precisely}}' == 'true'"
    },
    "Initialization": [
        "{{#condition.accel}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _w_{{self.name}}=0",
            " local _d_w_{{self.name}}=1/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.accel}}",
            "{{#condition.decel}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _w_{{self.name}}=0",
            " local _d_w_{{self.name}}=1/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.decel}}",
            "{{#condition.accDec}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _w_{{self.name}}=0",
            " local _d_w_{{self.name}}=1/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.accDec}}",
            "{{#condition.normal}}local _beg_{{self.name}}={{{self.from}}}",
            " local {{self.name}}=_beg_{{self.name}}",
            " local _end_{{self.name}}={{{self.to}}}",
            " local _d_{{self.name}}=(_end_{{self.name}}-_beg_{{self.name}})/({{{context.repeat.times}}}{{#condition.precise}}-1{{/condition.precise}})",
            "{{/condition.normal}}"
    ],
    "Update": [
        "{0:IND}",
            "{{#condition.accel}}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " {{self.name}}=(_end_{{self.name}}-_beg_{{self.name}})*_w_{{self.name}}^2+_beg_{{self.name}}",
            "{{/condition.accel}}",
            "{{#condition.decel}}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " {{self.name}}=(_beg_{{self.name}}-_end_{{self.name}})*(_w_{{self.name}}-1)^2+_end_{{self.name}}",
            "{{/condition.decel}}",
            "{{#condition.accDec}}_w_{{self.name}}=_w_{{self.name}}+_d_w_{{self.name}}",
            " if _w_{{self.name}}<0.5 then",
            " {{self.name}}=2*(_end_{{self.name}}-_beg_{{self.name}})*_w_{{self.name}}^2+_beg_{{self.name}}",
            " else",
            " {{self.name}}=(_end_{{self.name}}-_beg_{{self.name}})*(-2*_w_{{self.name}}^2+4*_w_{{self.name}}-1)+_beg_{{self.name}}",
            " end",
            "{{/condition.accDec}}",
            "{{#condition.normal}}{{self.name}}={{self.name}}+_d_{{self.name}}",
            "{{/condition.normal}}"
    ]
}
