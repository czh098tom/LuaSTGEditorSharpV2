<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lsv="clr-namespace:LuaSTGEditorSharpV2.View;assembly=LuaSTGEditorSharpV2.View">
    <DataTemplate x:Key="property:linqSTGBlueprintButton">
        <lsv:PropertyItemGrid>
            <Grid Grid.Column="0" Grid.ColumnSpan="3">
                <Button Content="{Binding ButtonCaption}"
                        Command="{Binding OpenWindow}"
                        HorizontalAlignment="Stretch"
                        Margin="5,2" />
            </Grid>
        </lsv:PropertyItemGrid>
    </DataTemplate>
</ResourceDictionary>
