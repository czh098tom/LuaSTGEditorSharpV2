<UserControl x:Class="LuaSTGEditorSharpV2.Package.LinqSTG.Windows.View.NodeCreationMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:LuaSTGEditorSharpV2.Package.LinqSTG.Windows.ViewModel.NodeCreationMenu"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter xmlns:local="clr-namespace:LuaSTGEditorSharpV2.Package.LinqSTG.Windows.View"
                                                   x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Recursive template: a category renders nested categories/nodes through the same two implicit templates. -->
        <DataTemplate DataType="{x:Type menu:NodeCreationCategoryViewModel}">
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Focusable="False" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="2,1">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8"
                                          Stroke="#FF9A9A9A" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="8,6,6,6" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <TextBlock Text="{Binding Name}" Foreground="#FFDDDDDD"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding Items}" Margin="12,0,0,0"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type menu:NodeCreationNodeItemViewModel}">
            <Button Click="NodeItem_Click" Cursor="Hand" ToolTip="{Binding EnglishTitle}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBackground" Background="Transparent" Padding="6,4,8,4" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FF3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Title}" Foreground="#FFC8C8C8" TextTrimming="CharacterEllipsis"/>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1"
            CornerRadius="4" Width="280">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,8,6">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF333337" Foreground="#FFF0F0F0"
                         BorderBrush="#FF3F3F46" BorderThickness="1"
                         CaretBrush="#FFF0F0F0" Padding="6,4"/>
                <TextBlock x:Name="SearchHint" Text=""
                           Foreground="#FF808080" Margin="8,6,4,4"
                           IsHitTestVisible="False" Visibility="Collapsed"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Rectangle Grid.Row="1" Fill="#FF3F3F46"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          MaxHeight="380" Margin="0,4,0,6">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Categories}"
                                  Visibility="{Binding IsListVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <ListBox x:Name="ResultList"
                             ItemsSource="{Binding SearchResults}"
                             Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseDoubleClick="ResultList_PreviewMouseDoubleClick"
                             KeyDown="ResultList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="#FFE8E8E8"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBackground" Background="Transparent"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBackground" Property="Background" Value="#FF3E3E42"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBackground" Property="Background" Value="#FF094771"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="#FFE8E8E8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#FF9B9B9B"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding NoMatchLabel}" Foreground="#FF9B9B9B"
                               Margin="10,8" TextWrapping="Wrap"
                               Visibility="{Binding IsNoMatch, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
