<Window x:Class="LuaSTGEditorSharpV2.Package.LinqSTG.Windows.BlueprintPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rc="clr-namespace:RichCanvas;assembly=RichCanvas"
        xmlns:draw="clr-namespace:System.Drawing;assembly=netstandard"
        xmlns:nodenetwork="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
        xmlns:local="clr-namespace:LuaSTGEditorSharpV2.Package.LinqSTG.Windows"
        xmlns:view="clr-namespace:LuaSTGEditorSharpV2.Package.LinqSTG.Windows.View"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="LuaSTGEditorSharpV2.Package.LinqSTG.Window"
        lex:ResxLocalizationProvider.DefaultDictionary="Localized"
        mc:Ignorable="d"
        Title="{lex:Loc linqstg_window_title}" Height="600" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <view:BooleanToIndexConverter x:Key="BooleanToIndexConverter"/>
        <view:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="PreviewHost" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>
            <Grid x:Name="PreviewArea" Grid.Row="0">
                <rc:RichItemsControl x:Name="PreviewCanvas"
                                     Background="#FF1E1E1E"
                                     HorizontalScrollBarVisibility="Hidden"
                                     VerticalScrollBarVisibility="Hidden">
                    <rc:RichItemsControl.Template>
                        <ControlTemplate TargetType="{x:Type rc:RichItemsControl}">
                            <ControlTemplate.Resources>
                                <DrawingBrush x:Key="PreviewGridBrush"
                                              TileMode="Tile"
                                              ViewportUnits="Absolute"
                                              Viewport="0,0,50,50">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Geometry="M10,0 L10,50 M20,0 L20,50 M30,0 L30,50 M40,0 L40,50 M0,10 L50,10 M0,20 L50,20 M0,30 L50,30 M0,40 L50,40">
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1" Brush="#FF2A2A2A"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                            <GeometryDrawing Geometry="M0,0 L0,50 M0,0 L50,0">
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1.5" Brush="#FF3C3C3C"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </ControlTemplate.Resources>
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                    <rc:PanningGrid x:Name="CanvasContainer">
                                        <Canvas RenderTransform="{Binding AppliedTransform, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Rectangle Canvas.Left="-192" Canvas.Top="-224" Width="384" Height="448"
                                                       Stroke="ForestGreen" StrokeThickness="1" Fill="#FF000000"/>
                                            <Rectangle Canvas.Left="-10000" Canvas.Top="-10000" Width="20000" Height="20000"
                                                       Fill="{StaticResource PreviewGridBrush}"/>
                                            <rc:RichCanvas x:Name="PART_Panel" IsItemsHost="True" />
                                            <local:BulletPreviewCanvas x:Name="BulletLayer"
                                                                       Canvas.Left="-10000" Canvas.Top="-10000"
                                                                       Width="20000" Height="20000"
                                                                       Bullets="{Binding Points}"/>
                                            <Rectangle x:Name="PART_SelectionRectangle"
                                                       Style="{TemplateBinding SelectionRectangleStyle}"
                                                       Canvas.Left="{Binding SelectionRectangle.X, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Canvas.Top="{Binding SelectionRectangle.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Width="{Binding SelectionRectangle.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Height="{Binding SelectionRectangle.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Canvas>
                                    </rc:PanningGrid>
                                </ScrollViewer>
                            </Grid>
                        </ControlTemplate>
                    </rc:RichItemsControl.Template>
                </rc:RichItemsControl>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseButton" Grid.Column="0" Click="PlayPauseButton_Click"
                            Width="30" Height="26" Margin="4,2" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Path Data="M 3,2 L 16,9 L 3,16 Z" Fill="#FF222222" Stretch="Fill">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M 3,2 L 7,2 L 7,16 L 3,16 Z M 11,2 L 15,2 L 15,16 L 11,16 Z" Fill="#FF222222" Stretch="Fill">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Slider Grid.Column="1" Value="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="{Binding TimeMinimum}" Maximum="{Binding TimeMaximum}"
                            VerticalAlignment="Center" Margin="4,0" TickPlacement="None"/>
                    <TextBlock Grid.Column="2" Text="{lex:Loc linqstg_window_label_time}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding Time}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{lex:Loc linqstg_window_label_start}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <TextBox Grid.Column="1" Text="{Binding TimeMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,2,4,2"/>
                    <TextBlock Grid.Column="2" Text="{lex:Loc linqstg_window_label_end}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <TextBox Grid.Column="3" Text="{Binding TimeMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,2,4,2"/>
                </Grid>
            </Grid>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="#FF2A2A2A"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Variable list docked to the left edge of the blueprint area. -->
            <Border Grid.Column="0" Width="240"
                    Background="#FFF6F6F6" BorderBrush="#FFBFBFBF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="4,3" Background="Transparent">
                        <Button x:Name="AddVariableButton" DockPanel.Dock="Right" Width="22" Height="22"
                                Margin="6,0,0,0" Content="+" FontWeight="Bold" FontSize="13"
                                Click="AddVariableButton_Click"
                                ToolTip="{lex:Loc linqstg_window_varList_add}"/>
                        <TextBlock Text="{lex:Loc linqstg_window_varList_title}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True"
                                  DragOver="VariableItemsControl_DragOver"
                                  Drop="VariableItemsControl_Drop">
                        <ItemsControl x:Name="VariableItemsControl"
                                      ItemsSource="{Binding VariableList.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="66"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x2261;" FontSize="13" Foreground="#FF7F7F7F"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                                   ToolTip="{lex:Loc linqstg_window_varList_drag}"
                                                   PreviewMouseLeftButtonDown="VariableGrip_PreviewMouseLeftButtonDown"
                                                   PreviewMouseMove="VariableGrip_PreviewMouseMove"/>
                                        <TextBox Grid.Column="1" Margin="1,1,2,1" Padding="2,0"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding Name, Mode=TwoWay}"
                                                 IsReadOnly="{Binding IsLocked}"
                                                 KeyDown="VariableTextBox_KeyDown"/>
                                        <TextBox Grid.Column="2" Margin="1,1,2,1" Padding="2,0"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding ValueText, Mode=TwoWay}"
                                                 KeyDown="VariableTextBox_KeyDown"/>
                                        <ComboBox Grid.Column="3" Margin="1,1,2,1"
                                                  SelectedIndex="{Binding IsInteger, Mode=TwoWay, Converter={StaticResource BooleanToIndexConverter}}">
                                            <ComboBoxItem Content="{lex:Loc linqstg_window_node_float}"/>
                                            <ComboBoxItem Content="{lex:Loc linqstg_window_node_int}"/>
                                        </ComboBox>
                                        <Button Grid.Column="4" Content="&#xD7;" FontSize="11" Width="20" Height="20"
                                                Padding="0,-1,0,0" Click="RemoveVariableButton_Click"
                                                IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                                ToolTip="{lex:Loc linqstg_window_varList_remove}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Random seed bar docked to the bottom of the variable list. -->
                    <Border Grid.Row="2" Background="#FFF0F0F0" BorderBrush="#FFBFBFBF" BorderThickness="0,1,0,0">
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{lex:Loc linqstg_window_label_randomSeed}"
                                       VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Seed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="2,2,4,2"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <nodenetwork:NetworkView x:Name="NetworkView" Grid.Column="1" ViewModel="{Binding Network}"
                                     AllowDrop="True"
                                     PreviewDragOver="NetworkView_PreviewDragOver"
                                     PreviewDrop="NetworkView_PreviewDrop"/>
        </Grid>

        <Popup x:Name="NodeCreationPopup"
               PlacementTarget="{Binding ElementName=NetworkView}"
               Placement="RelativePoint"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <view:NodeCreationMenuView x:Name="NodeCreationMenu" DataContext="{Binding NodeCreationMenu}"/>
        </Popup>
    </Grid>
</Window>
