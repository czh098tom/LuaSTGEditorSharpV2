<Window x:Class="LuaSTGEditorSharpV2.Package.LinqSTG.Windows.BlueprintPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rc="clr-namespace:RichCanvas;assembly=RichCanvas"
        xmlns:draw="clr-namespace:System.Drawing;assembly=netstandard"
        xmlns:nodenetwork="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
        xmlns:nodeList="clr-namespace:NodeNetwork.Toolkit.NodeList;assembly=NodeNetworkToolkit"
        xmlns:local="clr-namespace:LuaSTGEditorSharpV2.Package.LinqSTG.Windows"
        mc:Ignorable="d"
        Title="Blueprint Pattern" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>
            <Grid x:Name="PreviewHost" Grid.Row="0">
                <rc:RichItemsControl x:Name="PreviewCanvas" ItemsSource="{Binding Points}"
                                     Background="#FF1E1E1E"
                                     HorizontalScrollBarVisibility="Hidden"
                                     VerticalScrollBarVisibility="Hidden">
                    <rc:RichItemsControl.Template>
                        <ControlTemplate TargetType="{x:Type rc:RichItemsControl}">
                            <ControlTemplate.Resources>
                                <DrawingBrush x:Key="PreviewGridBrush"
                                              TileMode="Tile"
                                              ViewportUnits="Absolute"
                                              Viewport="0,0,50,50">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Geometry="M10,0 L10,50 M20,0 L20,50 M30,0 L30,50 M40,0 L40,50 M0,10 L50,10 M0,20 L50,20 M0,30 L50,30 M0,40 L50,40">
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1" Brush="#FF2A2A2A"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                            <GeometryDrawing Geometry="M0,0 L0,50 M0,0 L50,0">
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1.5" Brush="#FF3C3C3C"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </ControlTemplate.Resources>
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                                    <rc:PanningGrid x:Name="CanvasContainer">
                                        <Canvas RenderTransform="{Binding AppliedTransform, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Rectangle Canvas.Left="-192" Canvas.Top="-224" Width="384" Height="448"
                                                       Stroke="ForestGreen" StrokeThickness="1" Fill="#FF000000"/>
                                            <Rectangle Canvas.Left="-10000" Canvas.Top="-10000" Width="20000" Height="20000"
                                                       Fill="{StaticResource PreviewGridBrush}"/>
                                            <rc:RichCanvas x:Name="PART_Panel" IsItemsHost="True" />
                                            <Rectangle x:Name="PART_SelectionRectangle"
                                                       Style="{TemplateBinding SelectionRectangleStyle}"
                                                       Canvas.Left="{Binding SelectionRectangle.X, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Canvas.Top="{Binding SelectionRectangle.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Width="{Binding SelectionRectangle.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Height="{Binding SelectionRectangle.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Canvas>
                                    </rc:PanningGrid>
                                </ScrollViewer>
                            </Grid>
                        </ControlTemplate>
                    </rc:RichItemsControl.Template>
                    <rc:RichItemsControl.Resources>
                        <DataTemplate DataType="{x:Type local:BulletVisual}">
                            <Grid>
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                         Stroke="#FF0000" StrokeThickness="1" Fill="Transparent">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Shape}" Value="Square">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Rectangle Width="{Binding Diameter}" Height="{Binding Diameter}"
                                           Stroke="#FF0000" StrokeThickness="1" Fill="Transparent">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Shape}" Value="Square">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                        </DataTemplate>
                    </rc:RichItemsControl.Resources>

                    <rc:RichItemsControl.ItemContainerStyle>
                        <Style TargetType="rc:RichItemContainer">
                            <Setter Property="Left" Value="{Binding Position.X}" />
                            <Setter Property="Top" Value="{Binding Position.Y}" />
                        </Style>
                    </rc:RichItemsControl.ItemContainerStyle>
                </rc:RichItemsControl>
            </Grid>
            <Slider Grid.Row="1" Value="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1200"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0">
                <nodeList:NodeListView ViewModel="{Binding NodeList}"/>
            </Grid>
            <Grid Grid.Column="1">
                <nodenetwork:NetworkView ViewModel="{Binding Network}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
