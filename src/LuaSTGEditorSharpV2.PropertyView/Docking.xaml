<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lpv="clr-namespace:LuaSTGEditorSharpV2.PropertyView"
                    xmlns:fluent="clr-namespace:Fluent;assembly=Fluent"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com">
    <DataTemplate x:Key="PropertyPageViewModel">
        <Grid MinWidth="250">
            <TabControl x:Name="_propertyTab" ItemsSource="{Binding Tabs}" 
                        SelectedIndex="{Binding SelectedIndex}" >
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Caption}"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                                      VerticalScrollBarVisibility="Visible"
                                      Margin="5">
                            <ItemsControl ItemsSource="{Binding Properties}" Background="FloralWhite"
                                          Grid.IsSharedSizeScope="True"
                                          ItemContainerStyle="{DynamicResource ResourceKey=inspector:style}">
                                <ItemsControl.ItemTemplateSelector>
                                    <lpv:PropertyItemTemplateSelector Default="{StaticResource ResourceKey=property:default}"/>
                                </ItemsControl.ItemTemplateSelector>
                            </ItemsControl>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DataTemplate>
    <fluent:Button x:Key="button" Header="{lex:Loc LuaSTGEditorSharpV2.PropertyView:Localized:ribbon_buttom_property}"
                   Command="{Binding Command}"/>
</ResourceDictionary>