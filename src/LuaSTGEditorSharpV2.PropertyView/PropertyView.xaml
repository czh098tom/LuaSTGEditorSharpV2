<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:ce="clr-namespace:CommunityToolkit.Mvvm.ComponentModel;assembly=CommunityToolkit.Mvvm"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    xmlns:e="clr-namespace:LuaSTGEditorSharpV2.PropertyView.Editor"
                    xmlns:lsv="clr-namespace:LuaSTGEditorSharpV2.View;assembly=LuaSTGEditorSharpV2.View"
                    xmlns:lw="clr-namespace:LuaSTGEditorSharpV2.WPF;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:lwc="clr-namespace:LuaSTGEditorSharpV2.WPF.Converter;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:lpv="clr-namespace:LuaSTGEditorSharpV2.PropertyView"
                    xmlns:lpvc="clr-namespace:LuaSTGEditorSharpV2.PropertyView.Converter">
    <lpvc:BatchStatusToWaterMarkConverter x:Key="BatchStatusToWaterMarkConverter"/>
    <DataTemplate x:Key="property:default">
        <lsv:PropertyItemGrid>
            <TextBlock Text="{Binding Name}" 
                       Margin="5,0,5,0" />
            <xctk:WatermarkTextBox Grid.Column="1" Grid.ColumnSpan="2" 
                                   MinWidth="150"
                                   HorizontalAlignment="Stretch"
                                   Padding="0"
                                   Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   Watermark="{Binding BatchEditStatus, Converter={StaticResource BatchStatusToWaterMarkConverter}}">
            </xctk:WatermarkTextBox>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:childNode">
        <lsv:PropertyItemGrid>
            <Grid Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Tabs}" 
                              Grid.Column="1"
                              Grid.IsSharedSizeScope="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Properties}"
                                          Grid.IsSharedSizeScope="True"
                                          ItemContainerStyle="{DynamicResource ResourceKey=inspector:style}">
                                <ItemsControl.ItemTemplateSelector>
                                    <lpv:PropertyItemTemplateSelector Default="{StaticResource ResourceKey = property:default}"/>
                                </ItemsControl.ItemTemplateSelector>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:captionName">
        <lsv:PropertyItemGrid>
            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" 
                       Margin="5,0,5,0" 
                       Text="{Binding Name}" />
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:captionValue">
        <lsv:PropertyItemGrid>
            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" 
                       Margin="5,0,5,0" 
                       Text="{Binding Value}" />
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:editorBoolean">
        <lsv:PropertyItemGrid>
            <TextBlock Margin="5,0,5,0" 
                       Text="{Binding Name}"/>
            <CheckBox Grid.Column="1" 
                      MinWidth="150"
                      HorizontalAlignment="Stretch"
                      IsChecked="{Binding Value, Mode=TwoWay}"/>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <e:ComboBoxItemConverter x:Key="comboBoxConverter" 
                             ServiceProvider="{DynamicResource ResourceKey=HostServices}"/>
    <DataTemplate x:Key="property:comboBox">
        <lsv:PropertyItemGrid>
            <TextBlock Margin="5,0,5,0" 
                       Text="{Binding Name}"/>
            <ComboBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" IsEditable="True"
                      MinWidth="150"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Type.Parameters[Options], Mode=OneWay, Converter={StaticResource comboBoxConverter}}"/>
            <Button Grid.Column="2" Height="16" Content="...">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction PassEventArgsToCommand="True"
                                Command="{Binding ShowEditWindow}"
                                />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:code">
        <lsv:PropertyItemGrid>
            <TextBlock Margin="5,0,5,0"
                       Text="{Binding Name}"/>
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     MinWidth="150"
                     HorizontalAlignment="Stretch"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Height="16" Content="..." VerticalAlignment="Top">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction PassEventArgsToCommand="True"
                                Command="{Binding ShowEditWindow}"
                                />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:collectionCount">
        <lsv:PropertyItemGrid>
            <TextBlock Margin="5,0,5,0" 
                       Text="{Binding Name}"/>
            <Grid Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         MinWidth="150"
                         HorizontalAlignment="Stretch"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <Button Grid.Column="1" Content="+" Command="{Binding Increase}"/>
                <Button Grid.Column="2" Content="-" Command="{Binding Decrease}"/>
            </Grid>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <DataTemplate x:Key="property:file">
        <lsv:PropertyItemGrid>
            <TextBlock Text="{Binding Name}" 
                       Margin="5,0,5,0" />
            <Grid Grid.Column="1">
                <TextBox
                     MinWidth="150"
                     HorizontalAlignment="Stretch"
                     TextWrapping="Wrap"
                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
            <Button Grid.Column="2" Height="16" Content="..." VerticalAlignment="Top">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction PassEventArgsToCommand="True"
                                Command="{Binding ShowEditWindow}"
                                />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </lsv:PropertyItemGrid>
    </DataTemplate>
    <lwc:PathValidToVisibilityConverter x:Key="PathValidToVisibilityConverter"/>
    <DataTemplate x:Key="property:imageFile">
        <lsv:PropertyItemGrid>
            <TextBlock Text="{Binding Name}" 
                       Margin="5,0,5,0" />
            <TextBox Grid.Column="1"
                     MinWidth="150"
                     HorizontalAlignment="Stretch"
                     TextWrapping="Wrap"
                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <Button Grid.Column="2" Height="16" Content="..." VerticalAlignment="Top">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction PassEventArgsToCommand="True"
                                Command="{Binding ShowEditWindow}"
                                />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </lsv:PropertyItemGrid>
    </DataTemplate>
	<DataTemplate x:Key="property:imagePreview">
		<lsv:PropertyItemGrid>
			<Grid Grid.Column="0" Grid.ColumnSpan="3">
				<lw:FileButton Margin="10,10" FilePath="{Binding Value}"
                               Visibility="{Binding Value, Converter={StaticResource PathValidToVisibilityConverter}}"
                               VerticalContentAlignment="Center" 
                               HorizontalContentAlignment="Center"
                               OverridesDefaultStyle="True" Background="Transparent">
					<lw:FileButton.Style>
						<Style TargetType="Button">
							<Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
							<Setter Property="BorderThickness" Value="1"/>
							<Setter Property="Padding" Value="1"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="true">
											<ContentPresenter 
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Margin="{TemplateBinding Padding}"
                                                RecognizesAccessKey="True"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</lw:FileButton.Style>
					<lw:AutoScaleImage Source="{Binding Value}"/>
				</lw:FileButton>
			</Grid>
		</lsv:PropertyItemGrid>
	</DataTemplate>
</ResourceDictionary>