<Window x:Name="window"
        x:Class="LuaSTGEditorSharpV2.Dialog.VectorEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_title}"
        Width="665"
        Height="637"
        MinWidth="665"
        MinHeight="637"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DrawingBrush x:Key="VectorGridBrush"
                      Stretch="None"
                      TileMode="Tile"
                      Viewport="0,0 50,50"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                                <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#7F7F7F" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="10,0" EndPoint="10,50"/>
                                <LineGeometry StartPoint="0,10" EndPoint="50,10"/>
                                <LineGeometry StartPoint="20,0" EndPoint="20,50"/>
                                <LineGeometry StartPoint="0,20" EndPoint="50,20"/>
                                <LineGeometry StartPoint="30,0" EndPoint="30,50"/>
                                <LineGeometry StartPoint="0,30" EndPoint="50,30"/>
                                <LineGeometry StartPoint="40,0" EndPoint="40,50"/>
                                <LineGeometry StartPoint="0,40" EndPoint="50,40"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#BFBFBF" Thickness="0.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <Grid Height="32" Margin="5,4,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="1" Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_radius}"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Radius, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="3" Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_theta}"/>
                <TextBox Grid.Column="4"
                         Text="{Binding Theta, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Height="32" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="1" Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_offset}"/>
                <TextBox Grid.Column="2"
                         Text="{Binding OffsetX, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="3" Content=","/>
                <TextBox Grid.Column="4"
                         Text="{Binding OffsetY, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Height="32" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Tag="BeginX"
                         Text="{Binding BeginX, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="1" Content=","/>
                <TextBox Grid.Column="2"
                         Tag="BeginY"
                         Text="{Binding BeginY, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="3" Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_to}"/>
                <TextBox Grid.Column="4"
                         Tag="SelectedX"
                         Text="{Binding SelectedX, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Column="5" Content=","/>
                <TextBox Grid.Column="6"
                         Tag="SelectedY"
                         Text="{Binding SelectedY, ElementName=window, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Height="40" Margin="5,0,5,4">
                <WrapPanel HorizontalAlignment="Left">
                    <RadioButton Margin="5,5" IsChecked="True" Click="NotClip_Click"
                                 Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_do_not_clip}"/>
                    <RadioButton Margin="5,5" Click="ClipTo1_Click"
                                 Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_clip_to_1}"/>
                    <RadioButton Margin="5,5" Click="ClipTo10_Click"
                                 Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vectorEditor_clip_to_10}"/>
                </WrapPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="75" Margin="5,5,3,5" Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_ok}" IsDefault="True" Click="ButtonOK_Click"/>
                    <Button Width="75" Margin="3,5,5,5" Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_cancel}" IsCancel="True" Click="ButtonCancel_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <Border Margin="5" BorderBrush="#707070" BorderThickness="1">
            <Canvas x:Name="DrawingCanvas"
                    Width="640"
                    Height="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource VectorGridBrush}"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseRightButtonDown="Canvas_MouseRightButtonDown"
                    MouseRightButtonUp="Canvas_MouseRightButtonUp"
                    MouseMove="Canvas_MouseMove">
                <Line x:Name="horizontalAxis" X1="0" Y1="240" X2="640" Y2="240" Stroke="#808080" StrokeThickness="1"/>
                <Line x:Name="verticalAxis" X1="224" Y1="0" X2="224" Y2="480" Stroke="#808080" StrokeThickness="1"/>
                <Line x:Name="vectorLineBorder" Stroke="Black" StrokeThickness="4"/>
                <Line x:Name="vectorLine" Stroke="AliceBlue" StrokeThickness="2"/>
                <Ellipse x:Name="originMarker" Width="10" Height="10" Fill="AliceBlue" Stroke="Black" StrokeThickness="1"/>
                <Line x:Name="endCrossBorder1" Stroke="Black" StrokeThickness="4"/>
                <Line x:Name="endCrossBorder2" Stroke="Black" StrokeThickness="4"/>
                <Line x:Name="endCross1" Stroke="AliceBlue" StrokeThickness="2"/>
                <Line x:Name="endCross2" Stroke="AliceBlue" StrokeThickness="2"/>
            </Canvas>
        </Border>
    </DockPanel>
</Window>
