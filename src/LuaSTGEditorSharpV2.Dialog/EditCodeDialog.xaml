<lw:OKCancelWindow x:Class="LuaSTGEditorSharpV2.Dialog.EditCodeDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
                   xmlns:lw="clr-namespace:LuaSTGEditorSharpV2.WPF;assembly=LuaSTGEditorSharpV2.WPF"
                   xmlns:lex="http://wpflocalizeextension.codeplex.com"
                   Width="800"
                   Height="500"
                   MinWidth="480"
                   MinHeight="300"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ae:TextEditor x:Name="textEditor"
                       FontFamily="Consolas"
                       FontSize="14"
                       ShowLineNumbers="True"
                       WordWrap="False"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="75"
                    Margin="0,0,8,0"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_ok}"
                    IsDefault="True"
                    Click="OKButton_Click"/>
            <Button Width="75"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_cancel}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</lw:OKCancelWindow>
