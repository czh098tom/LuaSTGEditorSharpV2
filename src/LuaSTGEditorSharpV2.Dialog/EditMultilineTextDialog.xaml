<lw:OKCancelWindow x:Class="LuaSTGEditorSharpV2.Dialog.EditMultilineTextDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:lw="clr-namespace:LuaSTGEditorSharpV2.WPF;assembly=LuaSTGEditorSharpV2.WPF"
                   xmlns:lex="http://wpflocalizeextension.codeplex.com"
                   Width="700"
                   Height="420"
                   MinWidth="420"
                   MinHeight="240"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="textEditor"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="75"
                    Margin="0,0,8,0"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_ok}"
                    IsDefault="True"
                    Click="OKButton_Click"/>
            <Button Width="75"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_cancel}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</lw:OKCancelWindow>
