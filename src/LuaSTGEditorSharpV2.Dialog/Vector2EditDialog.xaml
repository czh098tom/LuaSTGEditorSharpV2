<lw:OKCancelWindow x:Class="LuaSTGEditorSharpV2.Dialog.Vector2EditDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:lw="clr-namespace:LuaSTGEditorSharpV2.WPF;assembly=LuaSTGEditorSharpV2.WPF"
                   xmlns:lwctrl="clr-namespace:LuaSTGEditorSharpV2.WPF.Controls;assembly=LuaSTGEditorSharpV2.WPF"
                   xmlns:localvm="clr-namespace:LuaSTGEditorSharpV2.Dialog.ViewModel"
                   xmlns:lex="http://wpflocalizeextension.codeplex.com"
                   mc:Ignorable="d"
                   Title="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_title}"
                   Width="760"
                   Height="520"
                   MinWidth="650"
                   MinHeight="420"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="VectorModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <localvm:Vector2EditDialogViewModel/>
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="expressionTextBox"
                 Grid.Row="0"
                 Tag="Expression"
                 Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <lwctrl:ExpressionSpinner Grid.Column="0"
                                      Height="24"
                                      Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text=","/>
            <lwctrl:ExpressionSpinner Grid.Column="2"
                                      Height="24"
                                      Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0"
                      Header="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_components}">
                <ListBox ItemsSource="{Binding Components}"
                         SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                         DisplayMemberPath="Display"/>
            </GroupBox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="X/Y"
                                 GroupName="VectorComponentEditMode"
                                 Style="{StaticResource VectorModeButtonStyle}"
                                 IsChecked="{Binding IsCurrentCartesian, Mode=TwoWay}"/>
                    <RadioButton Content="R/A"
                                 GroupName="VectorComponentEditMode"
                                 Margin="-1,0,0,0"
                                 Style="{StaticResource VectorModeButtonStyle}"
                                 IsChecked="{Binding IsCurrentPolar, Mode=TwoWay}"
                                 IsEnabled="{Binding CanCurrentUsePolar}"
                                 ToolTip="r*cos(a), r*sin(a)"/>
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentPolar}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="X"/>
                    <lwctrl:ExpressionSpinner Grid.Column="1"
                                              Height="24"
                                              Text="{Binding CurrentX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center" Text="Y"/>
                    <lwctrl:ExpressionSpinner Grid.Column="3"
                                              Height="24"
                                              Text="{Binding CurrentY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentPolar}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="R"/>
                    <lwctrl:ExpressionSpinner Grid.Column="1"
                                              Height="24"
                                              Text="{Binding CurrentRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center" Text="A"/>
                    <lwctrl:ExpressionSpinner Grid.Column="3"
                                              Height="24"
                                              Text="{Binding CurrentAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,8,0,0" IsEnabled="{Binding IsCurrentCartesian}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,4,0"
                            Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_sync_xy}"
                            Command="{Binding SyncXYCommand}"/>
                    <Button Grid.Column="1"
                            Margin="4,0,0,0"
                            Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_sync_trigonometrics}"
                            Command="{Binding SyncTrigonometricsCommand}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Tag="lstg.world.l" Content="←" Click="InsertButton_Click" ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_left}"/>
                    <Button Grid.Column="1" Tag="lstg.world.r" Content="→" Click="InsertButton_Click" ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_right}"/>
                    <Button Grid.Column="2" Tag="lstg.world.t" Content="↑" Click="InsertButton_Click" ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_top}"/>
                    <Button Grid.Column="3" Tag="lstg.world.b" Content="↓" Click="InsertButton_Click" ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_bottom}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="0,0,4,0" Tag="sin(" Content="sin(" Click="InsertButton_Click"/>
                    <Button Grid.Column="1" Margin="4,0,0,0" Tag="cos(" Content="cos(" Click="InsertButton_Click"/>
                </Grid>
                <Button Margin="0,8,0,0"
                        Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_open_vector_editor}"
                        Click="OpenVectorEditor_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="75"
                    Margin="0,0,8,0"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_ok}"
                    IsDefault="True"
                    Click="OKButton_Click"/>
            <Button Width="75"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_cancel}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</lw:OKCancelWindow>
