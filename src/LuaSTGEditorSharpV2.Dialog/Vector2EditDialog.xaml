<lw:OKCancelWindow x:Class="LuaSTGEditorSharpV2.Dialog.Vector2EditDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                   xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                   xmlns:lw="clr-namespace:LuaSTGEditorSharpV2.WPF;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:lwctrl="clr-namespace:LuaSTGEditorSharpV2.WPF.Controls;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:behavior="clr-namespace:LuaSTGEditorSharpV2.WPF.Behavior;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:local="clr-namespace:LuaSTGEditorSharpV2.Dialog"
                    xmlns:localvm="clr-namespace:LuaSTGEditorSharpV2.Dialog.ViewModel"
                    xmlns:localvmedit="clr-namespace:LuaSTGEditorSharpV2.Dialog.ViewModel.Vector2EditDialog"
                    xmlns:lex="http://wpflocalizeextension.codeplex.com"
                   mc:Ignorable="d"
                   Title="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_title}"
                   Width="760"
                   Height="520"
                   MinWidth="650"
                   MinHeight="420"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="VectorModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type localvmedit:CartesianEditorState}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Text="X"/>
                    <lwctrl:ExpressionSpinner Grid.Column="1"
                                              Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center"
                               Text="Y"/>
                    <lwctrl:ExpressionSpinner Grid.Column="3"
                                              Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,4,0"
                            Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_sync_xy}"
                            Command="{Binding SyncXYCommand}"/>
                    <Button Grid.Column="1"
                            Margin="4,0,0,0"
                            Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_sync_trigonometrics}"
                            Command="{Binding SyncTrigonometricsCommand}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type localvmedit:PolarEditorState}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Text="R"/>
                <lwctrl:ExpressionSpinner Grid.Column="1"
                                          Height="24"
                                          Text="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2"
                           Margin="8,0,6,0"
                           VerticalAlignment="Center"
                           Text="A"/>
                <lwctrl:ExpressionSpinner Grid.Column="3"
                                          Height="24"
                                          Text="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type localvmedit:MemberAccessEditorState}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <lwctrl:ExpressionSpinner Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Height="24"
                                          Watermark="Source"
                                          Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <lwctrl:ExpressionSpinner Grid.Row="1"
                                          Grid.Column="0"
                                          Height="24"
                                          Margin="0,8,4,0"
                                          Watermark="X"
                                          Text="{Binding FirstAccessor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <lwctrl:ExpressionSpinner Grid.Row="1"
                                          Grid.Column="1"
                                          Height="24"
                                          Margin="4,8,0,0"
                                          Watermark="Y"
                                          Text="{Binding SecondAccessor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type localvmedit:IndexAccessEditorState}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <lwctrl:ExpressionSpinner Grid.Row="0"
                                          Grid.ColumnSpan="2"
                                          Height="24"
                                          Watermark="Source"
                                          Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <lwctrl:ExpressionSpinner Grid.Row="1"
                                          Grid.Column="0"
                                          Height="24"
                                          Margin="0,8,4,0"
                                          Watermark="X"
                                          Text="{Binding FirstAccessor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <lwctrl:ExpressionSpinner Grid.Row="1"
                                          Grid.Column="1"
                                          Height="24"
                                          Margin="4,8,0,0"
                                          Watermark="Y"
                                          Text="{Binding SecondAccessor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <localvm:Vector2EditDialogViewModel/>
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="expressionTextBox"
                 Grid.Row="0"
                 Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <lwctrl:ExpressionSpinner Grid.Column="0"
                                      Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="1"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Text=","/>
            <lwctrl:ExpressionSpinner Grid.Column="2"
                                      Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_components}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <xctk:SplitButton Padding="8,0"
                                          Content="+"
                                          Command="{Binding AddCartesianComponentCommand}"
                                          ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_add_component}">
                            <xctk:SplitButton.DropDownContent>
                                <StackPanel>
                                    <MenuItem Header="X/Y (0, 0)"
                                              Command="{Binding AddCartesianComponentCommand}"/>
                                    <MenuItem Header="R/A (r, a)"
                                              Command="{Binding AddPolarComponentCommand}"/>
                                    <MenuItem Header="self.x/y"
                                              Command="{Binding AddMemberAccessComponentCommand}"/>
                                </StackPanel>
                            </xctk:SplitButton.DropDownContent>
                        </xctk:SplitButton>
                        <Button Margin="4,0,0,0"
                                Padding="8,0"
                                Content="-"
                                Command="{Binding RemoveComponentCommand}"
                                ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_remove_component}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1">
                    <ListBox ItemsSource="{Binding Components}"
                             SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                             DisplayMemberPath="Display">
                        <i:Interaction.Behaviors>
                            <behavior:ItemsControlReorderBehavior
                                ReorderCommand="{Binding ReorderComponentCommand}"/>
                        </i:Interaction.Behaviors>
                    </ListBox>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="X/Y"
                                 GroupName="VectorComponentEditorState"
                                 Style="{StaticResource VectorModeButtonStyle}"
                                 IsEnabled="{Binding HasSelectedComponent}"
                                 IsChecked="{Binding SelectedComponent.IsCartesianActive, Mode=TwoWay}"/>
                    <RadioButton Content="R/A"
                                 GroupName="VectorComponentEditorState"
                                 Margin="-1,0,0,0"
                                 Style="{StaticResource VectorModeButtonStyle}"
                                 IsChecked="{Binding SelectedComponent.IsPolarActive, Mode=TwoWay}"
                                 IsEnabled="{Binding SelectedComponent.CanUsePolar, TargetNullValue=False, FallbackValue=False}"
                                 ToolTip="r*cos(a), r*sin(a)"/>
                    <RadioButton Content="obj.x/y"
                                 GroupName="VectorComponentEditorState"
                                 Margin="-1,0,0,0"
                                 Style="{StaticResource VectorModeButtonStyle}"
                                 IsChecked="{Binding SelectedComponent.IsMemberAccessActive, Mode=TwoWay}"
                                 IsEnabled="{Binding SelectedComponent.CanUseMemberAccess, TargetNullValue=False, FallbackValue=False}"
                                 ToolTip="source.a, source.b"/>
                    <RadioButton Content="v[i]"
                                 GroupName="VectorComponentEditorState"
                                 Margin="-1,0,0,0"
                                 Style="{StaticResource VectorModeButtonStyle}"
                                 IsChecked="{Binding SelectedComponent.IsIndexAccessActive, Mode=TwoWay}"
                                 IsEnabled="{Binding SelectedComponent.CanUseIndexAccess, TargetNullValue=False, FallbackValue=False}"
                                 ToolTip="source[a], source[b]"/>
                </StackPanel>

                <ContentControl Margin="0,8,0,0"
                                Content="{Binding SelectedComponent.ActiveState}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Tag="lstg.world.l"
                            Content="←"
                            Command="{x:Static local:Vector2EditDialog.InsertTextCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_left}"/>
                    <Button Grid.Column="1"
                            Tag="lstg.world.r"
                            Content="→"
                            Command="{x:Static local:Vector2EditDialog.InsertTextCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_right}"/>
                    <Button Grid.Column="2"
                            Tag="lstg.world.t"
                            Content="↑"
                            Command="{x:Static local:Vector2EditDialog.InsertTextCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_top}"/>
                    <Button Grid.Column="3"
                            Tag="lstg.world.b"
                            Content="↓"
                            Command="{x:Static local:Vector2EditDialog.InsertTextCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            ToolTip="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_world_bottom}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,4,0"
                            Tag="sin("
                            Content="sin("
                            Command="{x:Static local:Vector2EditDialog.InsertTextCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                    <Button Grid.Column="1"
                            Margin="4,0,0,0"
                            Tag="cos("
                            Content="cos("
                            Command="{x:Static local:Vector2EditDialog.InsertTextCommand}"
                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                </Grid>
                <Button Margin="0,8,0,0"
                        Content="{lex:Loc LuaSTGEditorSharpV2.Dialog:Localized:vector2EditDialog_open_vector_editor}"
                        Command="{Binding OpenVectorEditorCommand}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="75"
                    Margin="0,0,8,0"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_ok}"
                    IsDefault="True"
                    Click="OKButton_Click"/>
            <Button Width="75"
                    Content="{lex:Loc LuaSTGEditorSharpV2.WPF:Localized:common_cancel}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</lw:OKCancelWindow>
