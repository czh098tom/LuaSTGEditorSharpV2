<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    xmlns:lwb="clr-namespace:LuaSTGEditorSharpV2.WPF.Behavior;assembly=LuaSTGEditorSharpV2.WPF"
                    xmlns:swm="clr-namespace:System.Windows.Media;assembly=PresentationCore">
    <s:Double x:Key="inspector:text_size">15</s:Double>
    <swm:FontFamily x:Key="inspector:font_family"></swm:FontFamily>
    <Style x:Key="inspector:style">
        <Style.Resources>
			<Style x:Key="font_setting">
				<Setter Property="Control.FontSize" Value="{DynamicResource ResourceKey=inspector:text_size}"/>
				<Setter Property="Control.FontFamily" Value="{DynamicResource ResourceKey=inspector:font_family}"/>
			</Style>
			<Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_setting}"/>
			<Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource font_setting}"/>
			<Style TargetType="{x:Type Button}" BasedOn="{StaticResource font_setting}">
				<Setter Property="Padding" Value="0"/>
				<Setter Property="VerticalAlignment" Value="Top"/>
				<Setter Property="lwb:EditorLayoutBehavior.MeasureTextLineHeight" Value="True"/>
				<Setter Property="Height"
						Value="{Binding RelativeSource={RelativeSource Self},
										Path=(lwb:EditorLayoutBehavior.MeasuredEditorHeight)}"/>
			</Style>
			<Style TargetType="{x:Type xctk:WatermarkTextBox}" BasedOn="{StaticResource font_setting}">
				<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
				<Setter Property="lwb:EditorVisualBehavior.EnabledBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
				<Setter Property="lwb:EditorVisualBehavior.DisabledBackground" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
				<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Padding" Value="0"/>
			</Style>
			<Style TargetType="{x:Type xctk:WatermarkComboBox}" BasedOn="{StaticResource font_setting}">
				<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
				<Setter Property="lwb:EditorVisualBehavior.EnabledBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
				<Setter Property="lwb:EditorVisualBehavior.DisabledBackground" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
				<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Padding" Value="0"/>
			</Style>
			<Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource font_setting}"/>
			<Style TargetType="{x:Type xctk:IntegerUpDown}" BasedOn="{StaticResource font_setting}"/>
			<Style TargetType="{x:Type xctk:DoubleUpDown}" BasedOn="{StaticResource font_setting}"/>
		</Style.Resources>
    </Style>
    <Brush x:Key="inspector:background_brush">White</Brush>
</ResourceDictionary>
